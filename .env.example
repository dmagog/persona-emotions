# OpenAI API key (required for LLM judge evaluation)
OPENAI_API_KEY="your token"
# Optional: custom OpenAI-compatible API base URL
# OPENAI_BASE_URL=https://api.openai.com/v1


# HuggingFace token (optional for public models / already-cached weights; required for gated repos / push_to_hub)
# HF_TOKEN=

# Optional: Weights & Biases project name
# WANDB_PROJECT=persona-vectors
