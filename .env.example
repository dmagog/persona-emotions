# OpenAI API key (required for LLM judge evaluation)
OPENAI_API_KEY=your-openai-api-key-here

# Optional: custom OpenAI-compatible API base URL
# OPENAI_BASE_URL=https://api.openai.com/v1

# HuggingFace token (required for gated model access)
HF_TOKEN=your-huggingface-token-here

# Optional: Weights & Biases project name
# WANDB_PROJECT=persona-vectors
